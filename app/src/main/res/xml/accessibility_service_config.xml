<?xml version="1.0" encoding="utf-8"?>
<!--
  只订阅下面这些包（微信、支付宝 + 美团/淘宝/天猫/饿了么/京东/拼多多的下单支付页）。
  必须和 ScreenPageParser.SCREEN_APPS 一致（有单测核对）。
  注意：这是「代码自律」，系统层面给的仍是全屏读取能力 —— 所以服务内部只认
  「支付成功」类结果页，且用黑名单排除账单页 / 订单列表 / 聊天页，避免误读。
  flagIncludeNotImportantViews：收银台、H5 结果页的金额节点常被标成「不重要」，不加就读不到。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_desc"
    android:notificationTimeout="200"
    android:packageNames="com.tencent.mm,com.eg.android.AlipayGphone,com.sankuai.meituan,com.sankuai.meituan.takeoutnew,com.taobao.taobao,com.tmall.wireless,me.ele,com.jingdong.app.mall,com.xunmeng.pinduoduo" />
